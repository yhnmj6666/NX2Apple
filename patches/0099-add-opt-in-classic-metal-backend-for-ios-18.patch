+@interface DmM3Compute : NSObject {
+    DmM3Table *table;
+    id<MTLComputePipelineState> pipeline;
+    uint64_t declared_generation;
+    NSMapTable *used_resources;
+}
+@property(strong) id<MTLCommandBuffer> commandBuffer;
+@property(strong) id<MTLComputeCommandEncoder> compute;
+@property(strong) id<MTLBlitCommandEncoder> blit;
+@property(copy) NSString *label;
+@end
+@implementation DmM3Compute
+- (BOOL)conformsToProtocol:(Protocol *)protocol {
+    return protocol == @protocol(MTL4CommandEncoder) || protocol == @protocol(MTL4ComputeCommandEncoder) || [super conformsToProtocol:protocol];
+}
+- (id<MTLComputeCommandEncoder>)computeEncoder {
+    if (_blit) { [_blit endEncoding]; _blit = nil; }
+    if (!_compute) {
+        _compute = [_commandBuffer computeCommandEncoder];
+        _compute.label = _label;
+        declared_generation = 0;
+        if (pipeline) [_compute setComputePipelineState:pipeline];
+        for (id resource in used_resources) [_compute useResource:resource usage:[[used_resources objectForKey:resource] unsignedIntegerValue]];
+    }
+    return _compute;
+}
+- (id<MTLBlitCommandEncoder>)blitEncoder {
+    if (_compute) { [_compute endEncoding]; _compute = nil; }
+    if (!_blit) { _blit = [_commandBuffer blitCommandEncoder]; _blit.label = _label; }
+    return _blit;
+}
+- (id)forwardingTargetForSelector:(SEL)selector { return [self computeEncoder]; }
+- (void)setArgumentTable:(DmM3Table *)value { table = value; }
+- (void)useResource:(id<MTLResource>)resource usage:(MTLResourceUsage)usage {
+    if (!used_resources) used_resources = [NSMapTable strongToStrongObjectsMapTable];
+    usage |= [[used_resources objectForKey:resource] unsignedIntegerValue];
+    [used_resources setObject:@(usage) forKey:resource];
+    [[self computeEncoder] useResource:resource usage:usage];
+}
+- (void)setComputePipelineState:(id<MTLComputePipelineState>)value {
+    pipeline = value;
+    [[self computeEncoder] setComputePipelineState:value];
+}
+- (void)bind {
+    id<MTLComputeCommandEncoder> encoder = [self computeEncoder];
+    m3_declare_buffers(encoder, 0, &declared_generation);
+    m3_bind_table(encoder, table, 0);
+}
+- (void)barrierAfterQueueStages:(MTLStages)after beforeStages:(MTLStages)before visibilityOptions:(MTL4VisibilityOptions)options {
+    (void)after; (void)before; (void)options;
+}
+- (void)barrierAfterStages:(MTLStages)after beforeQueueStages:(MTLStages)before visibilityOptions:(MTL4VisibilityOptions)options {
+    (void)after; (void)before; (void)options;
+}
+- (void)barrierAfterEncoderStages:(MTLStages)after beforeEncoderStages:(MTLStages)before visibilityOptions:(MTL4VisibilityOptions)options {
+    (void)after; (void)before; (void)options;
+    if (_compute) [_compute memoryBarrierWithScope:MTLBarrierScopeBuffers | MTLBarrierScopeTextures];
+}
+- (void)dispatchThreadgroups:(MTLSize)groups threadsPerThreadgroup:(MTLSize)threads {
+    [self bind]; [_compute dispatchThreadgroups:groups threadsPerThreadgroup:threads];
+}
+- (void)dispatchThreadgroupsWithIndirectBuffer:(MTLGPUAddress)address threadsPerThreadgroup:(MTLSize)threads {
+    NSUInteger offset; id<MTLBuffer> buffer = m3_buffer(address, &offset);
+    [self bind]; [_compute dispatchThreadgroupsWithIndirectBuffer:buffer indirectBufferOffset:offset threadsPerThreadgroup:threads];
+}
+- (void)copyFromBuffer:(id<MTLBuffer>)source sourceOffset:(NSUInteger)sourceOffset toBuffer:(id<MTLBuffer>)destination destinationOffset:(NSUInteger)destinationOffset size:(NSUInteger)size {
+    [[self blitEncoder] copyFromBuffer:source sourceOffset:sourceOffset toBuffer:destination destinationOffset:destinationOffset size:size];
+}
+- (void)copyFromBuffer:(id<MTLBuffer>)source sourceOffset:(NSUInteger)offset sourceBytesPerRow:(NSUInteger)row sourceBytesPerImage:(NSUInteger)image sourceSize:(MTLSize)size toTexture:(id<MTLTexture>)destination destinationSlice:(NSUInteger)slice destinationLevel:(NSUInteger)level destinationOrigin:(MTLOrigin)origin {
+    [[self blitEncoder] copyFromBuffer:source sourceOffset:offset sourceBytesPerRow:row sourceBytesPerImage:image sourceSize:size toTexture:destination destinationSlice:slice destinationLevel:level destinationOrigin:origin];
+}
+- (void)copyFromBuffer:(id<MTLBuffer>)source sourceOffset:(NSUInteger)offset sourceBytesPerRow:(NSUInteger)row sourceBytesPerImage:(NSUInteger)image sourceSize:(MTLSize)size toTexture:(id<MTLTexture>)destination destinationSlice:(NSUInteger)slice destinationLevel:(NSUInteger)level destinationOrigin:(MTLOrigin)origin options:(MTLBlitOption)options {
+    [[self blitEncoder] copyFromBuffer:source sourceOffset:offset sourceBytesPerRow:row sourceBytesPerImage:image sourceSize:size toTexture:destination destinationSlice:slice destinationLevel:level destinationOrigin:origin options:options];
+}
+- (void)copyFromTexture:(id<MTLTexture>)source sourceSlice:(NSUInteger)slice sourceLevel:(NSUInteger)level sourceOrigin:(MTLOrigin)origin sourceSize:(MTLSize)size toBuffer:(id<MTLBuffer>)destination destinationOffset:(NSUInteger)offset destinationBytesPerRow:(NSUInteger)row destinationBytesPerImage:(NSUInteger)image {
+    [[self blitEncoder] copyFromTexture:source sourceSlice:slice sourceLevel:level sourceOrigin:origin sourceSize:size toBuffer:destination destinationOffset:offset destinationBytesPerRow:row destinationBytesPerImage:image];
