+#import <Metal/Metal.h>
+#include <os/lock.h>
+#include <stdio.h>
+#include <stdlib.h>
+#import "nvn_metal3.h"
+
+#if DM_NVN_M3
+#undef MTLCreateSystemDefaultDevice
+#undef MTLDevice
+#undef MTL4CommandQueue
+#undef MTL4CommandBuffer
+#undef MTL4CommandAllocatorDescriptor
+#undef MTL4CommandQueueDescriptor
+#undef MTL4ArgumentTableDescriptor
+#undef MTL4CounterHeapDescriptor
+#undef MTL4CommitOptions
+#undef MTL4RenderPassDescriptor
+
+@implementation DmM3AllocatorDescriptor @end
+@implementation DmM3QueueDescriptor @end
+@implementation DmM3TableDescriptor @end
+@implementation DmM3CounterDescriptor @end
+
+@implementation DmM3CommitOptions
+- (void)addFeedbackHandler:(MTL4CommitFeedbackHandler)handler {
+    if (!_handlers) _handlers = [NSMutableArray array];
+    [_handlers addObject:[handler copy]];
+}
+@end
+
+static void m3_fail(NSString *reason) {
+    fprintf(stderr, "[dm] [metal3] FATAL %s\n", reason.UTF8String);
+    abort();
+}
+
+static os_unfair_lock registry_lock = OS_UNFAIR_LOCK_INIT;
+static NSHashTable *buffers;
+static NSMapTable<NSNumber *, id> *resources;
+static uint64_t buffer_generation;
+
+void dm_m3_track(id resource) {
+    if (!resource) return;
+    BOOL buffer = [resource conformsToProtocol:@protocol(MTLBuffer)];
+    BOOL has_id = [resource respondsToSelector:@selector(gpuResourceID)];
+    MTLResourceID rid = has_id ? [(id<MTLTexture>)resource gpuResourceID] : (MTLResourceID){0};
+    os_unfair_lock_lock(&registry_lock);
+    if (!resources) resources = [NSMapTable strongToWeakObjectsMapTable];
+    if (rid._impl) [resources setObject:resource forKey:@(rid._impl)];
+    if (buffer) {
+        if (!buffers) buffers = [NSHashTable weakObjectsHashTable];
+        if (![buffers containsObject:resource]) {
+            [buffers addObject:resource];
+            buffer_generation++;
+        }
+    }
+    os_unfair_lock_unlock(&registry_lock);
+}
+
+MTLResourceID dm_m3_resource_id(id resource) {
+    dm_m3_track(resource);
+    return resource ? [(id<MTLTexture>)resource gpuResourceID] : (MTLResourceID){0};
+}
+
+static id m3_resource(uint64_t rid) {
+    if (!rid) return nil;
+    os_unfair_lock_lock(&registry_lock);
+    id resource = [resources objectForKey:@(rid)];
+    os_unfair_lock_unlock(&registry_lock);
+    if (!resource) m3_fail([NSString stringWithFormat:@"unregistered resource ID %#llx", (unsigned long long)rid]);
+    return resource;
+}
+
+static id<MTLBuffer> m3_buffer(uint64_t address, NSUInteger *offset) {
+    *offset = 0;
+    if (!address) return nil;
+    os_unfair_lock_lock(&registry_lock);
+    id<MTLBuffer> found = nil;
+    for (id<MTLBuffer> buffer in buffers) {
+        uint64_t base = buffer.gpuAddress;
+        if (address >= base && address - base < buffer.length) {
+            found = buffer;
+            *offset = (NSUInteger)(address - base);
+            break;
+        }
+    }
+    os_unfair_lock_unlock(&registry_lock);
+    if (!found) m3_fail([NSString stringWithFormat:@"unregistered buffer address %#llx", (unsigned long long)address]);
+    return found;
+}
+
+static void m3_declare_buffers(id encoder, MTLRenderStages stages, uint64_t *generation) {
+    os_unfair_lock_lock(&registry_lock);
+    uint64_t current = buffer_generation;
+    NSArray *all = *generation != current ? buffers.allObjects : nil;
+    os_unfair_lock_unlock(&registry_lock);
+    if (!all) return;
+    for (id<MTLBuffer> buffer in all) {
+        if (stages) [(id<MTLRenderCommandEncoder>)encoder useResource:buffer usage:MTLResourceUsageRead | MTLResourceUsageWrite stages:stages];
+        else [(id<MTLComputeCommandEncoder>)encoder useResource:buffer usage:MTLResourceUsageRead | MTLResourceUsageWrite];
+    }
+    *generation = current;
+}
+
+@interface DmM3Residency : NSObject
+@property(strong) NSMutableSet *allocations;
+@property(copy) NSString *label;
+@end
+@implementation DmM3Residency
+- (instancetype)init {
+    if ((self = [super init])) _allocations = [NSMutableSet set];
+    return self;
+}
+- (void)addAllocation:(id)allocation { if (allocation) { dm_m3_track(allocation); @synchronized(self) { [_allocations addObject:allocation]; } } }
+- (void)removeAllocation:(id)allocation { if (allocation) @synchronized(self) { [_allocations removeObject:allocation]; } }
+- (void)removeAllAllocations { @synchronized(self) { [_allocations removeAllObjects]; } }
+- (NSArray *)allAllocations { @synchronized(self) { return _allocations.allObjects; } }
+- (NSUInteger)allocationCount { @synchronized(self) { return _allocations.count; } }
+- (NSUInteger)allocatedSize {
+    NSUInteger size = 0;
+    for (id<MTLAllocation> allocation in self.allAllocations) size += allocation.allocatedSize;
+    return size;
+}
+// Classic encoders retain and declare resources, so residency is managed by Metal.
+- (void)commit {}
+- (void)requestResidency {}
+- (void)endResidency {}
+@end
+
+@interface DmM3Allocator : NSObject
+@property(copy) NSString *label;
+@end
+@implementation DmM3Allocator
+- (void)reset {}
+- (NSUInteger)allocatedSize { return 0; }
+@end
+
+@interface DmM3Table : NSObject {
+@public
+    uint64_t addresses[31], textures[128], samplers[16];
+    uint32_t buffer_mask;
+    BOOL texture_set[128], sampler_set[16];
+}
+@end
+@implementation DmM3Table
+- (void)setAddress:(MTLGPUAddress)address atIndex:(NSUInteger)index {
+    if (index >= 31) m3_fail(@"buffer binding index out of range");
+    addresses[index] = address;
+    buffer_mask |= 1u << index;
+}
+- (void)setTexture:(MTLResourceID)resource atIndex:(NSUInteger)index {
+    if (index >= 128) m3_fail(@"texture binding index out of range");
+    textures[index] = resource._impl;
+    texture_set[index] = YES;
+}
+- (void)setSamplerState:(MTLResourceID)resource atIndex:(NSUInteger)index {
+    if (index >= 16) m3_fail(@"sampler binding index out of range");
+    samplers[index] = resource._impl;
+    sampler_set[index] = YES;
+}
+@end
+
+static void m3_bind_table(id encoder, DmM3Table *table, MTLRenderStages stage) {
+    if (!table) return;
+    for (NSUInteger i = 0; i < 31; i++) if (table->buffer_mask & (1u << i)) {
+        NSUInteger offset;
+        id<MTLBuffer> buffer = m3_buffer(table->addresses[i], &offset);
+        switch (stage) {
+        case MTLRenderStageVertex: [encoder setVertexBuffer:buffer offset:offset atIndex:i]; break;
+        case MTLRenderStageFragment: [encoder setFragmentBuffer:buffer offset:offset atIndex:i]; break;
+        case MTLRenderStageObject: [encoder setObjectBuffer:buffer offset:offset atIndex:i]; break;
+        case MTLRenderStageMesh: [encoder setMeshBuffer:buffer offset:offset atIndex:i]; break;
+        default: [encoder setBuffer:buffer offset:offset atIndex:i]; break;
+        }
+    }
+    for (NSUInteger i = 0; i < 128; i++) if (table->texture_set[i]) {
+        id texture = m3_resource(table->textures[i]);
+        switch (stage) {
+        case MTLRenderStageVertex: [encoder setVertexTexture:texture atIndex:i]; break;
+        case MTLRenderStageFragment: [encoder setFragmentTexture:texture atIndex:i]; break;
+        case MTLRenderStageObject: [encoder setObjectTexture:texture atIndex:i]; break;
+        case MTLRenderStageMesh: [encoder setMeshTexture:texture atIndex:i]; break;
+        default: [(id<MTLComputeCommandEncoder>)encoder setTexture:texture atIndex:i]; break;
+        }
+    }
+    for (NSUInteger i = 0; i < 16; i++) if (table->sampler_set[i]) {
+        id sampler = m3_resource(table->samplers[i]);
+        switch (stage) {
+        case MTLRenderStageVertex: [encoder setVertexSamplerState:sampler atIndex:i]; break;
+        case MTLRenderStageFragment: [encoder setFragmentSamplerState:sampler atIndex:i]; break;
+        case MTLRenderStageObject: [encoder setObjectSamplerState:sampler atIndex:i]; break;
+        case MTLRenderStageMesh: [encoder setMeshSamplerState:sampler atIndex:i]; break;
+        default: [(id<MTLComputeCommandEncoder>)encoder setSamplerState:sampler atIndex:i]; break;
+        }
+    }
+}
+
+@interface DmM3Render : NSObject {
+    DmM3Table *vertex_table, *fragment_table, *object_table, *mesh_table;
+    uint64_t declared_generation;
+    MTLRenderStages declared_stages;
+}
+@property(strong) id<MTLRenderCommandEncoder> encoder;
+@end
+@implementation DmM3Render
+- (id)forwardingTargetForSelector:(SEL)selector { return _encoder; }
+- (BOOL)conformsToProtocol:(Protocol *)protocol {
+    return protocol == @protocol(MTL4CommandEncoder) || protocol == @protocol(MTL4RenderCommandEncoder) || [super conformsToProtocol:protocol];
+}
+- (void)setArgumentTable:(DmM3Table *)table atStages:(MTLRenderStages)stages {
+    if (stages & MTLRenderStageVertex) vertex_table = table;
+    if (stages & MTLRenderStageFragment) fragment_table = table;
+    if (stages & MTLRenderStageObject) object_table = table;
+    if (stages & MTLRenderStageMesh) mesh_table = table;
+}
+- (void)bind:(BOOL)mesh {
+    MTLRenderStages stages = mesh ? MTLRenderStageObject | MTLRenderStageMesh | MTLRenderStageFragment : MTLRenderStageVertex | MTLRenderStageFragment;
+    if (stages != declared_stages) { declared_generation = 0; declared_stages = stages; }
+    m3_declare_buffers(_encoder, stages, &declared_generation);
+    if (!mesh) m3_bind_table(_encoder, vertex_table, MTLRenderStageVertex);
+    m3_bind_table(_encoder, fragment_table, MTLRenderStageFragment);
+    if (mesh) {
+        m3_bind_table(_encoder, object_table, MTLRenderStageObject);
+        m3_bind_table(_encoder, mesh_table, MTLRenderStageMesh);
+    }
+}
+- (void)barrierAfterQueueStages:(MTLStages)after beforeStages:(MTLStages)before visibilityOptions:(MTL4VisibilityOptions)options {
+    (void)after; (void)before; (void)options;
+}
+- (void)barrierAfterStages:(MTLStages)after beforeQueueStages:(MTLStages)before visibilityOptions:(MTL4VisibilityOptions)options {
+    (void)after; (void)before; (void)options;
+}
+- (void)barrierAfterEncoderStages:(MTLStages)after beforeEncoderStages:(MTLStages)before visibilityOptions:(MTL4VisibilityOptions)options {
+    (void)options;
+    MTLRenderStages source = 0, destination = 0;
+    if (after & MTLStageVertex) source |= MTLRenderStageVertex;
+    if (after & MTLStageFragment) source |= MTLRenderStageFragment;
+    if (after & MTLStageObject) source |= MTLRenderStageObject;
+    if (after & MTLStageMesh) source |= MTLRenderStageMesh;
+    if (before & MTLStageVertex) destination |= MTLRenderStageVertex;
+    if (before & MTLStageFragment) destination |= MTLRenderStageFragment;
+    if (before & MTLStageObject) destination |= MTLRenderStageObject;
+    if (before & MTLStageMesh) destination |= MTLRenderStageMesh;
+    if (source && destination) [_encoder memoryBarrierWithScope:MTLBarrierScopeBuffers | MTLBarrierScopeTextures | MTLBarrierScopeRenderTargets afterStages:source beforeStages:destination];
+}
+- (void)drawPrimitives:(MTLPrimitiveType)type vertexStart:(NSUInteger)start vertexCount:(NSUInteger)count {
+    [self bind:NO]; [_encoder drawPrimitives:type vertexStart:start vertexCount:count];
+}
+- (void)drawPrimitives:(MTLPrimitiveType)type vertexStart:(NSUInteger)start vertexCount:(NSUInteger)count instanceCount:(NSUInteger)instances baseInstance:(NSUInteger)base {
+    [self bind:NO]; [_encoder drawPrimitives:type vertexStart:start vertexCount:count instanceCount:instances baseInstance:base];
+}
+- (void)drawPrimitives:(MTLPrimitiveType)type indirectBuffer:(MTLGPUAddress)address {
+    NSUInteger offset; id<MTLBuffer> buffer = m3_buffer(address, &offset);
+    [self bind:NO]; [_encoder drawPrimitives:type indirectBuffer:buffer indirectBufferOffset:offset];
+}
+- (void)drawIndexedPrimitives:(MTLPrimitiveType)type indexCount:(NSUInteger)count indexType:(MTLIndexType)indexType indexBuffer:(MTLGPUAddress)address indexBufferLength:(NSUInteger)length instanceCount:(NSUInteger)instances baseVertex:(NSInteger)vertex baseInstance:(NSUInteger)instance {
+    (void)length;
+    NSUInteger offset; id<MTLBuffer> buffer = m3_buffer(address, &offset);
+    [self bind:NO]; [_encoder drawIndexedPrimitives:type indexCount:count indexType:indexType indexBuffer:buffer indexBufferOffset:offset instanceCount:instances baseVertex:vertex baseInstance:instance];
+}
+- (void)drawIndexedPrimitives:(MTLPrimitiveType)type indexType:(MTLIndexType)indexType indexBuffer:(MTLGPUAddress)address indexBufferLength:(NSUInteger)length indirectBuffer:(MTLGPUAddress)indirect {
+    (void)length;
+    NSUInteger offset, indirect_offset;
+    id<MTLBuffer> buffer = m3_buffer(address, &offset), args = m3_buffer(indirect, &indirect_offset);
+    [self bind:NO]; [_encoder drawIndexedPrimitives:type indexType:indexType indexBuffer:buffer indexBufferOffset:offset indirectBuffer:args indirectBufferOffset:indirect_offset];
+}
+- (void)drawMeshThreadgroups:(MTLSize)groups threadsPerObjectThreadgroup:(MTLSize)object threadsPerMeshThreadgroup:(MTLSize)mesh {
+    [self bind:YES]; [_encoder drawMeshThreadgroups:groups threadsPerObjectThreadgroup:object threadsPerMeshThreadgroup:mesh];
+}
+- (void)drawMeshThreadgroupsWithIndirectBuffer:(MTLGPUAddress)address threadsPerObjectThreadgroup:(MTLSize)object threadsPerMeshThreadgroup:(MTLSize)mesh {
+    NSUInteger offset; id<MTLBuffer> buffer = m3_buffer(address, &offset);
+    [self bind:YES]; [_encoder drawMeshThreadgroupsWithIndirectBuffer:buffer indirectBufferOffset:offset threadsPerObjectThreadgroup:object threadsPerMeshThreadgroup:mesh];
+}
+@end
