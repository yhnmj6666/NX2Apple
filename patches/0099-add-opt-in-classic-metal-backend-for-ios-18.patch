+}
+- (id<MTLBuffer>)newBufferWithBytes:(const void *)bytes length:(NSUInteger)length options:(MTLResourceOptions)options {
+    id<MTLBuffer> buffer = [_device newBufferWithBytes:bytes length:length options:options]; dm_m3_track(buffer); return buffer;
+}
+- (id<MTLBuffer>)newBufferWithBytesNoCopy:(void *)bytes length:(NSUInteger)length options:(MTLResourceOptions)options deallocator:(void (^)(void *, NSUInteger))deallocator {
+    id<MTLBuffer> buffer = [_device newBufferWithBytesNoCopy:bytes length:length options:options deallocator:deallocator]; dm_m3_track(buffer); return buffer;
+}
+@end
