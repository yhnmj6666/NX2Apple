diff --git a/dm/gfx/tests/t_metal3.m b/dm/gfx/tests/t_metal3.m
new file mode 100644
index 0000000..9df0a0f
--- /dev/null
+++ b/dm/gfx/tests/t_metal3.m
@@ -0,0 +1,180 @@
+#import <Metal/Metal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#import "../nvn/nvn_metal3.h"
+
+#define CHECK(condition) do { if (!(condition)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); exit(1); } } while (0)
+
+static id<MTLDevice> device;
+static id<MTL4CommandQueue> queue;
+static id<MTL4CommandAllocator> allocator;
+static id<MTLLibrary> library;
+
+static id<MTL4CommandBuffer> begin(void) {
+    id<MTL4CommandBuffer> buffer = [device newCommandBuffer];
+    [buffer beginCommandBufferWithAllocator:allocator];
+    return buffer;
+}
+
+static void finish(id<MTL4CommandBuffer> buffer) {
+    [buffer endCommandBuffer];
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    MTL4CommitOptions *options = [MTL4CommitOptions new];
+    [options addFeedbackHandler:^(id<MTL4CommitFeedback> feedback) {
+        CHECK(!feedback.error);
+        dispatch_semaphore_signal(done);
+    }];
+    id<MTL4CommandBuffer> buffers[] = {buffer};
+    [queue commit:buffers count:1 options:options];
+    CHECK(dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, 30 * NSEC_PER_SEC)) == 0);
+}
+
+static id<MTL4ArgumentTable> table(void) {
+    MTL4ArgumentTableDescriptor *descriptor = [MTL4ArgumentTableDescriptor new];
+    descriptor.maxBufferBindCount = 3;
+    descriptor.maxTextureBindCount = 1;
+    descriptor.maxSamplerStateBindCount = 1;
+    id<MTL4ArgumentTable> result = [device newArgumentTableWithDescriptor:descriptor error:nil];
+    CHECK(result);
+    return result;
+}
+
+static id<MTLComputePipelineState> compute(NSString *name) {
+    NSError *error = nil;
+    id<MTLComputePipelineState> result = [device newComputePipelineStateWithFunction:[library newFunctionWithName:name] error:&error];
+    if (error) fprintf(stderr, "%s\n", error.description.UTF8String);
+    CHECK(result);
+    return result;
+}
+
+static void test_compute_blit_switching(void) {
+    id<MTLBuffer> data = [device newBufferWithLength:64 options:MTLResourceStorageModeShared];
+    id<MTLBuffer> copy = [device newBufferWithLength:16 options:MTLResourceStorageModeShared];
+    uint32_t increment = 7;
+    id<MTLBuffer> value = [device newBufferWithBytes:&increment length:sizeof increment options:MTLResourceStorageModeShared];
+    id<MTL4ArgumentTable> arguments = table();
+    [arguments setAddress:data.gpuAddress + 16 atIndex:0];
+    [arguments setAddress:value.gpuAddress atIndex:1];
+    id<MTL4CommandBuffer> buffer = begin();
+    id<MTL4ComputeCommandEncoder> encoder = [buffer computeCommandEncoder];
+    [encoder fillBuffer:data range:NSMakeRange(16, 4) value:2];
+    [encoder setComputePipelineState:compute(@"increment")];
+    [encoder setArgumentTable:arguments];
+    [encoder dispatchThreadgroups:MTLSizeMake(1, 1, 1) threadsPerThreadgroup:MTLSizeMake(1, 1, 1)];
+    [encoder copyFromBuffer:data sourceOffset:16 toBuffer:copy destinationOffset:0 size:4];
+    [encoder fillBuffer:data range:NSMakeRange(32, 4) value:3];
+    [arguments setAddress:data.gpuAddress + 32 atIndex:0];
+    [encoder dispatchThreadgroups:MTLSizeMake(1, 1, 1) threadsPerThreadgroup:MTLSizeMake(1, 1, 1)];
+    [encoder endEncoding];
+    finish(buffer);
+    CHECK(*(uint32_t *)copy.contents == 0x02020209);
+    CHECK(((uint32_t *)data.contents)[8] == 0x0303030a);
+}
+
+static void test_indirect_resources_and_reuse(void) {
+    id<MTLBuffer> destination = [device newBufferWithLength:64 options:MTLResourceStorageModeShared];
+    struct { uint64_t address; uint32_t value, padding; } values = {destination.gpuAddress + 16, 0x12345678, 0};
+    id<MTLBuffer> block = [device newBufferWithBytes:&values length:sizeof values options:MTLResourceStorageModeShared];
+    id<MTL4ArgumentTable> arguments = table();
+    [arguments setAddress:block.gpuAddress atIndex:0];
+    id<MTLComputePipelineState> pipeline = compute(@"indirect");
+    id<MTL4CommandBuffer> buffer = begin();
+    for (unsigned i = 0; i < 2; i++) {
+        if (i) {
+            ((uint32_t *)block.contents)[2]++;
+            [allocator reset];
+            [buffer beginCommandBufferWithAllocator:allocator];
+        }
+        id<MTL4ComputeCommandEncoder> encoder = [buffer computeCommandEncoder];
+        [encoder setComputePipelineState:pipeline];
+        [encoder setArgumentTable:arguments];
+        [encoder dispatchThreadgroups:MTLSizeMake(1, 1, 1) threadsPerThreadgroup:MTLSizeMake(1, 1, 1)];
+        [encoder endEncoding];
+        finish(buffer);
+        CHECK(((uint32_t *)destination.contents)[4] == 0x12345678 + i);
+    }
+}
+
+static void test_render_bindings_and_index_offsets(void) {
+    NSError *error = nil;
+    MTLRenderPipelineDescriptor *pipelineDescriptor = [MTLRenderPipelineDescriptor new];
+    pipelineDescriptor.vertexFunction = [library newFunctionWithName:@"vertex_main"];
+    pipelineDescriptor.fragmentFunction = [library newFunctionWithName:@"fragment_main"];
+    pipelineDescriptor.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    id<MTLRenderPipelineState> pipeline = [device newRenderPipelineStateWithDescriptor:pipelineDescriptor error:&error];
+    if (error) fprintf(stderr, "%s\n", error.description.UTF8String);
+    CHECK(pipeline);
+
+    float colors[12] = {0, 0, 0, 0, 1, 0, 0, 1, 0, 1, 0, 1};
+    uint16_t indices[5] = {0xffff, 0xffff, 0, 1, 2};
+    id<MTLBuffer> color = [device newBufferWithBytes:colors length:sizeof colors options:MTLResourceStorageModeShared];
+    id<MTLBuffer> index = [device newBufferWithBytes:indices length:sizeof indices options:MTLResourceStorageModeShared];
+    MTLTextureDescriptor *descriptor = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:1 height:1 mipmapped:NO];
+    descriptor.storageMode = MTLStorageModeShared;
+    descriptor.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+    id<MTLTexture> white = [device newTextureWithDescriptor:descriptor];
+    uint32_t pixel = 0xffffffff;
+    [white replaceRegion:MTLRegionMake2D(0, 0, 1, 1) mipmapLevel:0 withBytes:&pixel bytesPerRow:4];
+    id<MTLTexture> view = [white newTextureViewWithPixelFormat:white.pixelFormat];
+    MTLSamplerDescriptor *samplerDescriptor = [MTLSamplerDescriptor new];
+    samplerDescriptor.supportArgumentBuffers = YES;
+    id<MTLSamplerState> sampler = [device newSamplerStateWithDescriptor:samplerDescriptor];
+    id<MTL4ArgumentTable> arguments = table();
+    [arguments setAddress:color.gpuAddress + 16 atIndex:0];
+    [arguments setTexture:DM_RID(view) atIndex:0];
+    [arguments setSamplerState:DM_RID(sampler) atIndex:0];
+
+    descriptor = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:2 height:1 mipmapped:NO];
+    descriptor.storageMode = MTLStorageModePrivate;
+    descriptor.usage = MTLTextureUsageRenderTarget;
+    id<MTLTexture> target = [device newTextureWithDescriptor:descriptor];
+    MTL4RenderPassDescriptor *pass = [MTL4RenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = target;
+    pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTL4CommandBuffer> buffer = begin();
+    id<MTL4RenderCommandEncoder> encoder = [buffer renderCommandEncoderWithDescriptor:pass];
+    [encoder setRenderPipelineState:pipeline];
+    [encoder setArgumentTable:arguments atStages:MTLRenderStageFragment];
+    [encoder setScissorRect:(MTLScissorRect){0, 0, 1, 1}];
+    [encoder drawIndexedPrimitives:MTLPrimitiveTypeTriangle indexCount:3 indexType:MTLIndexTypeUInt16 indexBuffer:index.gpuAddress + 4 indexBufferLength:6 instanceCount:1 baseVertex:0 baseInstance:0];
+    [encoder barrierAfterEncoderStages:MTLStageFragment beforeEncoderStages:MTLStageFragment visibilityOptions:MTL4VisibilityOptionDevice];
+    [arguments setAddress:color.gpuAddress + 32 atIndex:0];
+    [encoder setScissorRect:(MTLScissorRect){1, 0, 1, 1}];
+    [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [encoder endEncoding];
+    id<MTLBuffer> readback = [device newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    id<MTL4ComputeCommandEncoder> blit = [buffer computeCommandEncoder];
+    [blit copyFromTexture:target sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(2, 1, 1) toBuffer:readback destinationOffset:0 destinationBytesPerRow:256 destinationBytesPerImage:256];
+    [blit endEncoding];
+    finish(buffer);
+    const uint8_t expected[] = {255, 0, 0, 255, 0, 255, 0, 255};
+    CHECK(memcmp(readback.contents, expected, sizeof expected) == 0);
+}
+
+int main(void) {
+    @autoreleasepool {
+        device = MTLCreateSystemDefaultDevice();
+        CHECK(device);
+        queue = [device newMTL4CommandQueueWithDescriptor:[MTL4CommandQueueDescriptor new] error:nil];
+        allocator = [device newCommandAllocatorWithDescriptor:[MTL4CommandAllocatorDescriptor new] error:nil];
+        CHECK(queue && allocator);
+        NSString *source =
+            @"#include <metal_stdlib>\nusing namespace metal;\n"
+             "kernel void increment(device uint *out [[buffer(0)]], constant uint &value [[buffer(1)]]) { *out += value; }\n"
+             "struct Indirect { device uint *out; uint value; };\n"
+             "kernel void indirect(constant Indirect &args [[buffer(0)]]) { *args.out = args.value; }\n"
+             "vertex float4 vertex_main(uint i [[vertex_id]]) { const float2 p[] = {float2(-1,-1),float2(3,-1),float2(-1,3)}; return float4(p[i],0,1); }\n"
+             "fragment float4 fragment_main(constant float4 &color [[buffer(0)]], texture2d<float> tex [[texture(0)]], sampler s [[sampler(0)]]) { return color * tex.sample(s,float2(0.5)); }\n";
+        NSError *error = nil;
+        library = [device newLibraryWithSource:source options:nil error:&error];
+        if (error) fprintf(stderr, "%s\n", error.description.UTF8String);
+        CHECK(library);
+        test_compute_blit_switching();
+        test_indirect_resources_and_reuse();
+        test_render_bindings_and_index_offsets();
+        puts("Metal 3: mixed encoders, mutable bindings, indirect resources, buffer reuse and indexed rendering passed");
+    }
+    return 0;
+}
